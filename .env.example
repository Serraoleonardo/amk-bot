# Claude (Anthropic)
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://SUA-EVOLUTION-API
EVOLUTION_API_KEY=coloque_sua_chave_aqui
EVOLUTION_INSTANCE=amk-amazonika

# Número do administrador (DDI + DDD + número, só dígitos)
ADMIN_PHONE_NUMBER=55DDDNUMERO
# Use "off" para não notificar o administrador
NOTIFY_ADMIN=on

# Chave PIX informada ao cliente no fechamento da venda
PIX_KEY=

# Estoque: "mock" usa data/estoque.json; deixe vazio para usar o Google Sheets
STOCK_BACKEND=mock
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
# Alternativa ao arquivo: cole o JSON da conta de serviço
GOOGLE_SERVICE_ACCOUNT_JSON=

PORT=3000
